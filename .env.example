# Copy this file to .env for local dev.
#
# Recommended hybrid setup:
# - Vercel hosts the frontend.
# - Apps Script remains the backend.
# - Set APPS_SCRIPT_WEB_APP_URL locally and in Vercel Project Settings.
APPS_SCRIPT_WEB_APP_URL=

# Local development only: set to 1 when you want /api/rpc to use the
# Node handlers first, with unported functions falling back to Apps Script.
FORCE_LOCAL_BACKEND=0

# Optional: short server-side cache for read-only Apps Script calls proxied
# through /api/rpc. Set to 0 to disable.
APPS_SCRIPT_READ_CACHE_TTL_MS=15000

# Optional only if you use the partially ported Vercel backend instead
# of Apps Script. Leave these blank for the hybrid setup.

# The spreadsheet ID is the long string in the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=

# From the service account JSON key file Google Cloud gives you
# (see README.md "Google Cloud setup" section).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
