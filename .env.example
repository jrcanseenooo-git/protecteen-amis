# Copy this file to .env (local dev) and also add the same three
# values in Vercel: Project Settings -> Environment Variables.

# The spreadsheet ID is the long string in the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=

# From the service account JSON key file Google Cloud gives you
# (see README.md "Google Cloud setup" section).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
